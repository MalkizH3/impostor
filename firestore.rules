rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHost(room) {
      return room.hostId == request.auth.uid;
    }

    function isPlayer(room) {
      return room.players is list && request.auth.uid in room.players.map(player => player.id);
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.players is list
        && request.resource.data.players.size() > 0
        && request.resource.data.players[0].id == request.auth.uid;

      allow read: if signedIn() && (isHost(resource.data) || isPlayer(resource.data));

      allow update: if signedIn()
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.players is list
        && (isHost(resource.data) || isPlayer(resource.data));

      allow delete: if false;
    }
  }
}
